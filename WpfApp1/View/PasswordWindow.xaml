<Window x:Class="WpfApp1.View.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Проверка доступа"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource {x:Type Window}}">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>   <!-- подписи: ширина по самой длинной -->
            <ColumnDefinition Width="220"/>    <!-- поля -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Введите логин:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource DataZone}"
                 Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"/>

        <Label Grid.Row="1" Grid.Column="0" Content="Введите пароль:" VerticalAlignment="Center" Margin="0,8,0,0"/>
        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource DataZone}" Margin="0,8,0,0"
                 Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"/>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Сверить" Command="{Binding LoginingCommand}" Width="100" Margin="0,0,8,0" IsDefault="True"/>
            <Button Content="Очистить" Command="{Binding ClearInputCommand}" Width="100"/>
        </StackPanel>

        <TextBlock Grid.Row="3" Grid.ColumnSpan="2"
                   Text="{Binding StatusMessage}"
                   Foreground="#DC2626"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"/>
    </Grid>
</Window>
